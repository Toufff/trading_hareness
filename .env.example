# Copy to .env and set real credentials locally. Never commit the real .env.
QUANT_WRITE_API_KEY=replace-me
QUANT_ALERT_WEBHOOK_TOKEN=replace-me

# Optional runtime overrides; defaults are defined in compose.yaml.
INTRADAY_SCAN_INTERVAL_SECONDS=30
INTRADAY_SUPER_GET_FAST_INTERVAL_SECONDS=1
INTRADAY_SUPER_GET_FAST_MAX_SYMBOLS=40
INTRADAY_ORDER_BOOK_INTERVAL_SECONDS=3

# 群消息转发：机器人加入/可见源群后按群名自动发现；可改为明确 chat_id。
FEISHU_GROUP_RELAY_ENABLED=true
FEISHU_GROUP_RELAY_INTERVAL_SECONDS=10
FEISHU_GROUP_RELAY_HISTORY_LOOKBACK_SECONDS=300
FEISHU_GROUP_RELAY_BOOTSTRAP_MODE=skip_existing
FEISHU_GROUP_RELAY_RECONCILE_SECONDS=21600
FEISHU_GROUP_RELAY_RECONCILE_LOOKBACK_SECONDS=86400
FEISHU_GROUP_RELAY_TARGET_CHAT_ID=oc_523b7e9e29854acba64272a948cb8eda
FEISHU_GROUP_RELAY_ANQIANG_CHAT_ID=oc_1de6464db12c43bf60985f7131e6334a
FEISHU_GROUP_RELAY_ANQIANG_CHAT_NAME=马安强 (1)
FEISHU_GROUP_RELAY_LIWEI_CHAT_ID=oc_4ed9fdb72a152bc921b2d34bd4a1df14
FEISHU_GROUP_RELAY_LIWEI_CHAT_NAME=消息更新群
FEISHU_GROUP_RELAY_QUANNENG_CHAT_ID=oc_d6a89890c3a62517116a2c63f015e0a0
FEISHU_GROUP_RELAY_QUANNENG_CHAT_NAME=新野人哥会员群【禁言】
FEISHU_USER_OAUTH_REDIRECT_URI=http://localhost:8080/callback

# 飞书分析师工作台：均为可选。不要把 token、app secret 写入前端或提交到 Git。
# H5 地址必须是飞书开发者后台登记过的公网 HTTPS 域名。
FEISHU_WORKBENCH_PUBLIC_BASE_URL=
FEISHU_WORKBENCH_DRIVE_FOLDER_TOKEN=
FEISHU_WORKBENCH_WIKI_SPACE_ID=
FEISHU_WORKBENCH_TASKLIST_GUID=
FEISHU_WORKBENCH_BASE_APP_TOKEN=
FEISHU_WORKBENCH_BASE_TABLE_ID=
FEISHU_WORKBENCH_CALENDAR_ID=
FEISHU_WORKBENCH_APPROVAL_CODE=
FEISHU_WORKBENCH_AILY_APP_ID=
