<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.papa.n8n-execution-reconcile</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/papa/codebase/n8n/scripts/reconcile-stale-n8n-executions.sh</string>
    <string>--older-than-seconds</string>
    <string>600</string>
  </array>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/papa/codebase/n8n/logs/n8n-execution-reconcile.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/papa/codebase/n8n/logs/n8n-execution-reconcile.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/papa/codebase/n8n</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
