# Private runtime configuration and credentials
.env
.env.*
!.env.example
certs/

# Local n8n exports and workflow generators retain private endpoints and
# credential bindings.  They remain available for local operations but must
# never be added to the public source repository.
workflows/managed/
scripts/build-*-workflow.mjs
!scripts/build-remote-archive-sync-workflow.mjs
scripts/fix-native-reserve.mjs
scripts/harden-text-submit-workflow.mjs
scripts/patch-feishu-workflow.mjs
scripts/reconcile-text-item-workflow.mjs

# Runtime state, local backups and generated logs
backups/
logs/
state/
quant-service/reports/
*.dump
*.manifest
*.log

# Local WeChat desktop listeners and extraction helpers.  These processes
# consume the user's local WeChat database/key material and are intentionally
# kept out of GitHub; only the Feishu adapter contract is repository code.
scripts/wechat-*-relay.py
scripts/wechat-xiaolan-backfill.py
scripts/wechat_article_enricher.py
scripts/wechat_sqlcipher.py
scripts/tests/test_wechat_article_enricher.py
scripts/start-wechat-*-relay.sh
scripts/stop-wechat-*-relay.sh
launchd/com.papa.wechat-*-relay.plist

