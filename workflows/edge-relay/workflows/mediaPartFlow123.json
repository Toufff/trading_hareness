      "name": "Attach reserved upload session",
      "parameters": {
        "jsCode": "const inbound = $('Prepare media input').first();\nconst body = inbound.json.body ?? inbound.json;\nconst existing = $('Reserve upload in existing batch');\nconst reserved = existing.isExecuted ? existing.first().json : $('Reserve upload in new batch').first().json;\nif (!reserved?.upload?.id) throw new Error('reserve 未返回 upload.id');\nlet createdBatchId = null;\ntry { createdBatchId = $('Create batch').item.json.batch?.id ?? null; } catch {}\nconst batchId = body.batch_id || $json.batch?.id || createdBatchId;\nif (!batchId) throw new Error(`缺少 batch_id; create batch outputs=${JSON.stringify($('Create batch').all().map((item) => item.json?.batch?.id ?? null))}`);\nreturn [{ json: { batch_id: String(batchId), upload_id: String(reserved.upload.id) }, binary: inbound.binary ?? {} }];",
