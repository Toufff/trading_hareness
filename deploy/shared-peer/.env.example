PEER_SSH_HOST=your-lightserver-host
# For a peer running on lightServer itself, use its verified private address,
# not a public hairpin. Optionally preserve the existing known_hosts identity:
# PEER_SSH_HOST_KEY_ALIAS=[your-lightserver-host]:3535
PEER_SSH_HOST_KEY_ALIAS=
PEER_SSH_PORT=3535
PEER_SSH_USER=stockpeer
PEER_SSH_KEY_PATH=/home/stockpeer/.ssh/id_ed25519
PEER_KNOWN_HOSTS_PATH=/home/stockpeer/.ssh/known_hosts
REMOTE_DB_PORT=15432
REMOTE_API_PORT=15681

# Optional batch (bulk/COPY) database path; off unless PEER_BATCH_DB_PORT is
# set. It needs the owner's separate batch tunnel task
# (trading-hareness-shared-peer-batch-tunnel) publishing 127.0.0.1:15433 on
# lightServer. Once enabled, point long exports/COPY jobs at db-tunnel:5433 and
# leave db-tunnel:5432 to intraday queries: same owner database, two different
# SSH connections, so a bulk transfer no longer fills the intraday TCP window.
# PEER_BATCH_DB_PORT=5433
PEER_BATCH_REMOTE_PORT=15433

PEER_DB_USER=stock_peer
PEER_DB_PASSWORD=replace-me
PEER_QUANT_DATABASE=trading_hareness
PEER_N8N_DATABASE=trading_hareness_peer_n8n
PEER_BACKGROUND_TASKS_ENABLED=false
PEER_QUANT_WRITE_API_KEY=replace-me
QUANT_SHARED_READ_API_KEY=replace-me
PEER_N8N_ENCRYPTION_KEY=replace-me
PEER_QUANT_PORT=15682
PEER_N8N_PORT=15678
PEER_WHEELHOUSE_PATH=/home/stockpeer/wheelhouse
