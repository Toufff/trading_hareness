PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=quant_intraday_edge
PGUSER=quant_edge
PGPASSWORD=
PYTHONPATH=/opt/quant-intraday-edge/quant-service
QUANT_DATA_DIR=/var/lib/quant-intraday-edge
TZ=Asia/Shanghai

QUANT_RUNTIME_PROFILE=intraday_edge
QUANT_BACKGROUND_TASKS_ENABLED=true
QUANT_LEGACY_SCHEMA_BOOTSTRAP=false
QUANT_MIGRATION_LOCK_TIMEOUT_SECONDS=120
QUANT_DB_POOL_MIN_SIZE=1
QUANT_DB_POOL_MAX_SIZE=6
QUANT_DB_POOL_TIMEOUT_SECONDS=10
QUANT_PROVIDER_GLOBAL_RATE_LIMIT_MAX_WAIT_SECONDS=8

QUANT_FEISHU_DIRECT_ENABLED=true
QUANT_ALERT_WEBHOOK_URL=
QUANT_ALERT_WEBHOOK_TOKEN=

INTRADAY_SCAN_INTERVAL_SECONDS=30
INTRADAY_SUPER_GET_FAST_INTERVAL_SECONDS=2
INTRADAY_SUPER_GET_FAST_MAX_IN_FLIGHT=6
INTRADAY_SUPER_GET_FAST_MAX_SYMBOLS=36
INTRADAY_FAST_QUOTE_RETENTION_DAYS=3
INTRADAY_ORDER_BOOK_ENABLED=true
INTRADAY_ORDER_BOOK_INTERVAL_SECONDS=5
INTRADAY_ORDER_BOOK_MAX_SYMBOLS=36
INTRADAY_ORDER_BOOK_RETENTION_DAYS=3
INTRADAY_MINUTE_PROFILE_CAPTURE_ENABLED=true
INTRADAY_MINUTE_PROFILE_MAX_SYMBOLS=36
INTRADAY_MINUTE_PROFILE_RETENTION_DAYS=30
INTRADAY_BOARD_CURVE_ENABLED=true
INTRADAY_BOARD_CURVE_RETENTION_DAYS=14
INTRADAY_BOARD_ROTATION_RETENTION_DAYS=14
INTRADAY_RULE_INPUT_RETENTION_DAYS=30
INTRADAY_EPHEMERAL_SIGNAL_RETENTION_DAYS=30

STRATEGY_REVIEW_AUTOMATION_ENABLED=false
POST_CLOSE_STRATEGY_AUTOMATION_ENABLED=false
TEN_DAY_LEADER_ROTATION_AUTOMATION_ENABLED=false
DAILY_SUMMARY_AUTOMATION_ENABLED=false
THS_CONCEPT_MEMBER_BACKFILL_ENABLED=false
ALL_BOARD_MEMBER_BACKFILL_ENABLED=false

AKSHARE_MAX_WORKERS=2
TUSHARE_SUPER_GET_MAX_WORKERS=4
QUANT_RUNTIME_MIN_FREE_BYTES=8589934592
QUANT_RUNTIME_MAX_MEMORY_RATIO=0.80
QUANT_RESEARCH_STORAGE_SOFT_BYTES=4294967296
QUANT_HOT_DATABASE_SOFT_BYTES=3221225472
