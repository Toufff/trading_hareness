[Unit]
Description=Run quant edge market-session freshness acceptance twice each weekday

[Timer]
OnCalendar=Mon..Fri *-*-* 09:35:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 13:05:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=20
Unit=quant-intraday-edge-live-acceptance.service

[Install]
WantedBy=timers.target
